@model Book
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="mb-1">
    @Model.Title
    @if (!Model.IsActive)
    {
        <span class="badge text-bg-secondary align-middle fs-6">Inativo</span>
    }
</h1>
<p class="text-muted mb-4">@Model.Author</p>

<dl class="row col-lg-8">
    <dt class="col-sm-4">Situação</dt>
    <dd class="col-sm-8">@(Model.IsActive ? "Ativo" : "Inativo: não aparece no catálogo")</dd>

    <dt class="col-sm-4">ISBN</dt>
    <dd class="col-sm-8">@Model.ISBN</dd>

    <dt class="col-sm-4">Publicação</dt>
    <dd class="col-sm-8">@Model.PublishedAt.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-4">Exemplares</dt>
    <dd class="col-sm-8">@Model.Copies.Count</dd>

    <dt class="col-sm-4">Cadastrado em</dt>
    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<div class="d-flex flex-wrap gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    @if (Model.IsActive)
    {
        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-warning">Desativar</button>
        </form>
    }
    else
    {
        <form asp-action="Reactivate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-success">Reativar</button>
        </form>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Excluir</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
