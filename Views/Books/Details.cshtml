@using Library.DTOs.BookCopies
@model Book
@{
    ViewData["Title"] = Model.Title;

    var copies = Model.Copies.OrderBy(c => c.Code).ToList();
    var isLibrarian = User.IsInRole(nameof(UserRole.Librarian));

    // Leitores veem só os exemplares ativos; o bibliotecário vê todos para poder gerenciá-los.
    if (!isLibrarian)
    {
        copies = copies.Where(c => c.IsActive).ToList();
    }

    // Contado depois do filtro para o "X de Y" bater com a tabela que cada perfil vê.
    var total = copies.Count;
    var available = copies.Count(c => c.IsActive && c.Status == BookCopyStatus.Available);
}

<h1 class="mb-1">
    @Model.Title
    @if (!Model.IsActive)
    {
        <span class="badge text-bg-secondary align-middle fs-6">Inativo</span>
    }
</h1>
<p class="text-muted mb-4">@Model.Author</p>

<dl class="row col-lg-8">
    <dt class="col-sm-4">Situação</dt>
    <dd class="col-sm-8">@(Model.IsActive ? "Ativo" : "Inativo: não aparece no catálogo")</dd>

    <dt class="col-sm-4">ISBN</dt>
    <dd class="col-sm-8">@Model.ISBN</dd>

    <dt class="col-sm-4">Publicação</dt>
    <dd class="col-sm-8">@Model.PublishedAt.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-4">Exemplares</dt>
    <dd class="col-sm-8">
        @if (total == 0)
        {
            <span class="text-muted">Nenhum exemplar ainda</span>
        }
        else
        {
            <span>@available de @total disponíveis</span>
        }
    </dd>

    <dt class="col-sm-4">Cadastrado em</dt>
    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<div class="d-flex flex-wrap gap-2 mb-5">
    @if (isLibrarian)
    {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    if (Model.IsActive)
    {
        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-warning">Desativar</button>
        </form>
    }
    else
    {
        <form asp-action="Reactivate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-success">Reativar</button>
        </form>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Excluir</a>
    }
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<section>
    <h2 class="h4 mb-3">Exemplares</h2>

    @if (copies.Count == 0)
    {
        <p class="text-muted">Nenhum exemplar cadastrado.@(isLibrarian ? " Adicione o primeiro abaixo." : "")</p>
    }
    else
    {
        <table class="table align-middle col-lg-10">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Status</th>
                    @if (isLibrarian)
                    {
                        <th class="text-end">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var copy in copies)
                {
                    <tr>
                        <td>@copy.Code</td>
                        <td>
                            @switch (copy.Status)
                            {
                                case BookCopyStatus.Available:
                                    <span class="badge text-bg-success">Disponível</span>
                                    break;
                                case BookCopyStatus.Loaned:
                                    <span class="badge text-bg-info">Emprestado</span>
                                    break;
                                case BookCopyStatus.Lost:
                                    <span class="badge text-bg-dark">Perdido</span>
                                    break;
                            }
                            @if (!copy.IsActive)
                            {
                                <span class="badge text-bg-secondary ms-1">Inativo</span>
                            }
                        </td>
                        @if (isLibrarian)
                        {
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                @if (copy.Status != BookCopyStatus.Loaned)
                                {
                                    if (copy.Status == BookCopyStatus.Lost)
                                    {
                                        <form asp-controller="BookCopies" asp-action="MarkAvailable" method="post">
                                            <input type="hidden" name="id" value="@copy.Id" />
                                            <input type="hidden" name="bookId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Disponível</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="BookCopies" asp-action="MarkLost" method="post">
                                            <input type="hidden" name="id" value="@copy.Id" />
                                            <input type="hidden" name="bookId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-dark">Perdido</button>
                                        </form>
                                    }
                                }
                                @if (copy.IsActive)
                                {
                                    <form asp-controller="BookCopies" asp-action="Deactivate" method="post">
                                        <input type="hidden" name="id" value="@copy.Id" />
                                        <input type="hidden" name="bookId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Desativar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="BookCopies" asp-action="Reactivate" method="post">
                                        <input type="hidden" name="id" value="@copy.Id" />
                                        <input type="hidden" name="bookId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Reativar</button>
                                    </form>
                                    <form asp-controller="BookCopies" asp-action="Delete" method="post"
                                          onsubmit="return confirm('Excluir o exemplar @copy.Code? O registro fica guardado no banco.');">
                                        <input type="hidden" name="id" value="@copy.Id" />
                                        <input type="hidden" name="bookId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                    </form>
                                }
                            </div>
                        </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (isLibrarian)
    {
    <form asp-controller="BookCopies" asp-action="Create" method="post" class="row g-2 col-lg-8 mt-2">
        <input type="hidden" name="BookId" value="@Model.Id" />
        <div class="col-sm-8">
            <label class="form-label" for="Code">Código do novo exemplar</label>
            <input type="text" name="Code" id="Code" class="form-control" maxlength="30"
                   placeholder="Ex.: EX-001" required />
        </div>
        <div class="col-sm-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Adicionar exemplar</button>
        </div>
    </form>
    }
</section>
