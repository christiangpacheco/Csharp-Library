@model UpdateBookDto
@{
    ViewData["Title"] = "Editar livro";
}

<h1 class="mb-4">Editar livro</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-8">
    <input type="hidden" asp-for="Id" />
    <partial name="_BookForm" model="Model" />

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
