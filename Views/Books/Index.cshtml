@model BookIndexViewModel
@{
    ViewData["Title"] = "Livros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Livros</h1>
    <a asp-action="Create" class="btn btn-primary">Novo livro</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4" role="search">
    <div class="col-sm-8 col-lg-6">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Buscar por título, autor ou ISBN" aria-label="Buscar" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" name="inactive" value="true" id="inactive" checked="@Model.IncludeInactive" />
            <label class="form-check-label" for="inactive">Mostrar inativos</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Search) || Model.IncludeInactive)
        {
            <a asp-action="Index" class="btn btn-link">Limpar</a>
        }
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">
        @(string.IsNullOrEmpty(Model.Search) ? "Nenhum livro cadastrado ainda." : $"Nenhum livro encontrado para \"{Model.Search}\".")
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Publicação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@book.Id">@book.Title</a>
                        @if (!book.IsActive)
                        {
                            <span class="badge text-bg-secondary ms-1">Inativo</span>
                        }
                    </td>
                    <td>@book.Author</td>
                    <td>@book.ISBN</td>
                    <td>@book.PublishedAt.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">@Model.TotalCount livro(s)</span>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginação">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-inactive="@(Model.IncludeInactive ? "true" : null)" asp-route-page="@(Model.Page - 1)">Anterior</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-inactive="@(Model.IncludeInactive ? "true" : null)" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-inactive="@(Model.IncludeInactive ? "true" : null)" asp-route-page="@(Model.Page + 1)">Próxima</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
