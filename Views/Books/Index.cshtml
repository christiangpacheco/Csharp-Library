@model List<Book>
@{
    ViewData["Title"] = "Livros";
}

<h1 class="mb-4">Livros</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Nenhum livro cadastrado ainda.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Publicação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.ISBN</td>
                    <td>@book.PublishedAt.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
