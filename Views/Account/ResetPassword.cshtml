@model Library.DTOs.Account.ResetPasswordDto
@{
    ViewData["Title"] = "Redefinir senha";
}

<h1 class="mb-4">Redefinir senha</h1>

<form asp-action="ResetPassword" method="post" class="col-md-6 col-lg-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Token" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Redefinir senha</button>
    <a asp-action="Login" class="btn btn-link">Voltar para entrar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
