@model Library.DTOs.Loans.CreateLoanDto
@{
    ViewData["Title"] = "Emprestar exemplar";
    var copy = (Library.Models.BookCopy)ViewBag.Copy;
    var borrowers = (IReadOnlyList<Library.Models.User>)ViewBag.Borrowers;
}

<h1 class="mb-1">Emprestar exemplar</h1>
<p class="text-muted mb-4">
    <strong>@copy.Book.Title</strong> — exemplar <strong>@copy.Code</strong>
</p>

<div class="col-md-6 col-lg-5">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="BookCopyId" />

        <div class="mb-3">
            <label asp-for="UserId" class="form-label"></label>
            <select asp-for="UserId" class="form-select">
                <option value="">Escolha o leitor...</option>
                @foreach (var user in borrowers)
                {
                    <option value="@user.Id">@user.Name (@user.Email)</option>
                }
            </select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Emprestar</button>
        <a asp-controller="Books" asp-action="Details" asp-route-id="@copy.BookId" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
