@model IReadOnlyList<Library.DTOs.Loans.LoanResponseDto>
@{
    ViewData["Title"] = "Empréstimos em aberto";
    var overdue = Model.Count(l => l.IsOverdue);
}

<h1 class="mb-1">Empréstimos em aberto</h1>
<p class="text-muted mb-4">
    @Model.Count em aberto@(overdue > 0 ? $", {overdue} atrasado(s)" : "")
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Nenhum empréstimo em aberto.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Livro</th>
                <th>Exemplar</th>
                <th>Leitor</th>
                <th>Emprestado em</th>
                <th>Vence</th>
                <th class="text-end">Ação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model)
            {
                <tr class="@(loan.IsOverdue ? "table-danger" : "")">
                    <td><a asp-controller="Books" asp-action="Details" asp-route-id="@loan.BookId">@loan.BookTitle</a></td>
                    <td>@loan.BookCopyCode</td>
                    <td>
                        @loan.UserName
                        <div class="text-muted small">@loan.UserEmail</div>
                    </td>
                    <td>@loan.BorrowedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>
                        @loan.DueDate.ToString("dd/MM/yyyy")
                        @if (loan.IsOverdue)
                        {
                            <span class="badge text-bg-danger ms-1">Atrasado</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-action="Return" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@loan.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Devolver</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
